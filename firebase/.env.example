# Copy this file to .env.local (never commit .env.local)
#
# Firebase Web App — Project settings → Your apps → SDK setup (npm / config object).
# Only variables prefixed with VITE_ are exposed to the browser via Vite.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional (Analytics). Omit or leave empty if unused.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional — admin product image uploads (ImgBB)
VITE_IMGBB_API_KEY=
